     = {|
         abi_mismatch := false;
         type_mismatches := [("P"%cpp_name, mismatch.Incompatible)];
         symbol_mismatches :=
           [("only_left()"%cpp_name, mismatch.Missing);
            ("f()"%cpp_name, mismatch.Incompatible)];
         assert_mismatches :=
           [{|
              sa_message := "only on the left";
              sa_condition :=
                Ebinop Bge (Esizeof (inl "int"%cpp_type) "unsigned long")
                  (Ecast (Cintegral "unsigned long") (Eint 2 "int")) "bool"
            |}]
       |}
     : sub_module_mismatch_t
     = {|
         abi_mismatch := true;
         type_mismatches :=
           [("__builtin_va_list"%cpp_name, mismatch.Incompatible)];
         symbol_mismatches := [];
         assert_mismatches := []
       |}
     : sub_module_mismatch_t
     = {|
         abi_mismatch := false;
         type_mismatches := [];
         symbol_mismatches := [];
         assert_mismatches :=
           [{|
              sa_message := "extra";
              sa_condition :=
                Ebinop Beq (Esizeof (inl "char"%cpp_type) "unsigned long")
                  (Ecast (Cintegral "unsigned long") (Eint 1 "int")) "bool"
            |}]
       |}
     : sub_module_mismatch_t
