DECLARE PLUGIN "rocq-skylabs-brick.plugin"

{
open Stdarg
open Procq.Constr

let any_attribute : Attributes.vernac_flags Attributes.attribute =
  Attributes.make_attribute (fun x -> [],x)
}

VERNAC COMMAND EXTEND Cpp CLASSIFIED AS SIDEFF
| #[ atts = Cpp2v.attributes ] [ "cpp.ast" ident(name) "abi" constr(abi) "defns" constr_list(defns) ] ->
  { Cpp2v.cpp_command atts name (Some abi) defns }
| #[ atts = Cpp2v.attributes ] [ "cpp.ast" ident(name) "defns" constr_list(defns) ] ->
  { Cpp2v.cpp_command atts name None defns }
END
