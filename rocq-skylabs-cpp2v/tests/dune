; Unsandboxed: the recorded workspace is relative to this file's final location.
(rule
 (target cpp_environment)
 (deps
  (universe)
  (sandbox none)
  (env_var CPP2V_DOCKER_ENABLED)
  (env_var CPP2V_DOCKER_IMAGE)
  (env_var CPP2V_DOCKER_USER))
 (action
  (run
   %{bin:cpp2v-toolchain}
   configure
   --output
   %{target}
   --default-image
   skylabsai/fm-releases:fm-release-nightly
   --platform
   linux/amd64
   --opam)))

(rule
 (target setup-cpp2v-command.sh)
 (action
  (with-stdout-to
   %{target}
   (progn
    ; The subshell keeps the adapter's exec from replacing the Cram shell.
    (echo "cpp2v_command() (\nconfig=$(mktemp)\ntrap 'rm -f \"$config\"' EXIT\ncat > \"$config\" <<'EOF'\n")
    (cat %{dep:cpp_environment})
    (echo "EOF\nset -- \"$config\" \"$@\"\n")
    (run
     %{bin:cpp2v-toolchain}
     wrapper
     --config-from-argument
     --runner
     %{bin:cpp2v-run}
     --host-tool
     %{bin:cpp2v}
     --container-tool
     cpp2v)
    (echo ")\n")))))

(cram
 (applies_to :whole_subtree)
 (setup_scripts
  setup.sh
  setup-project.sh
  setup-cpp2v-command.sh
  setup-cpp2v.sh
  setup-name-test.sh)
 (shell bash)
 (deps
  (package rocq-core)
  (package rocq-stdlib)
  (package rocq-stdpp)
  (package rocq-iris)
  (package rocq-elpi)
  (package rocq-equations)
  (package rocq-flocq)
  (package rocq-upoly)
  (package rocq-skylabs-prelude)
  (package rocq-skylabs-iris)
  (package ltac2-extra)
  (package rocq-lens)
  (package rocq-lens-elpi)
  (package rocq-skylabs-brick)
  (package rocq-skylabs-cpp2v)
  (package rocq-skylabs-brick-cpp-prog)))

; Issue #510: a 1,000,000-byte string literal. The source is generated so
; that the literal is not checked in.
(rule
 (target long_string_literal.cpp)
 (action
  (with-stdout-to
   %{target}
   (system
    "printf 'const char *text() { return \"'; printf '%1000000s' '' | tr ' ' a; echo '\"; }'"))))

(cram
 (applies_to long_string_literal)
 (deps long_string_literal.cpp))
